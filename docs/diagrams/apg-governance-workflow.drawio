  <diagram id="apg-governance-workflow" name="APG Governance Workflow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="APG governance workflow&#xa;APG 治理工作流" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=24;fontColor=#1D3557;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="880" height="50" as="geometry"/></mxCell>
        <mxCell id="3" value="1. Inspect facts&#xa;确认项目根、规则、Git 与现有证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#457B9D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="4" value="2. Doctor&#xa;治理状态是否自洽？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="5" value="3. Audit / Adopt preview&#xa;未接入项目：只读审计与接入预览" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="6" value="4. Bound change&#xa;changed paths、验收、非目标、回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#457B9D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1020" y="130" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="7" value="High risk or structural?&#xa;高风险或结构性变更？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="8" value="plan-change preview&#xa;影响分析与审批范围（不执行写入）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="320" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="9" value="Owner authorization&#xa;项目根与精确路径授权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="10" value="Implement bounded change&#xa;仅修改获批路径，保留用户与历史证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#457B9D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="11" value="Run affected Gates&#xa;fast / full checks；首个失败即停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="12" value="Pass?&#xa;验证是否通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="13" value="Receipt + hashes + post-state&#xa;收据、清单哈希与交付证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="510" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="14" value="Rollback only on exact post-state&#xa;验证后置状态后最小范围恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="690" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="15" value="External delivery boundaries&#xa;每一步均为独立事务，不能相互推断" style="swimlane;startSize=32;html=1;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="480" height="300" as="geometry"/></mxCell>
        <mxCell id="16" value="Public publication&#xa;公开发布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="15"><mxGeometry x="20" y="60" width="200" height="60" as="geometry"/></mxCell>
